#: ../../source/example_gallery/helmholtz_dtn.rst:581
#: 115b68bafd1745718ec7d692bbc87967
msgid ""
"Lower-case :math:`r_m,t_m` denote complex amplitudes.  Reflectance and "
"transmittance are power fractions:"
msgstr "小写的 :math:`r_m,t_m` 表示复振幅。反射率与透射率是功率比例："

#: ../../source/example_gallery/helmholtz_dtn.rst:584
#: f8c8b40c1b554fd183b525300852426a
msgid ""
"\\mathcal R_m=\n"
"\\frac{\\operatorname{Re}(a_t\\beta_{t,m})}\n"
"     {\\operatorname{Re}(a_t\\beta_{t,0})}\n"
"\\left|\\frac{r_m}{A}\\right|^2,\n"
"\\qquad\n"
"\\mathcal T_m=\n"
"\\frac{\\operatorname{Re}(a_b\\beta_{b,m})}\n"
"     {\\operatorname{Re}(a_t\\beta_{t,0})}\n"
"\\left|\\frac{t_m}{A}\\right|^2."
msgstr ""
"\\mathcal R_m=\n"
"\\frac{\\operatorname{Re}(a_t\\beta_{t,m})}\n"
"     {\\operatorname{Re}(a_t\\beta_{t,0})}\n"
"\\left|\\frac{r_m}{A}\\right|^2,\n"
"\\qquad\n"
"\\mathcal T_m=\n"
"\\frac{\\operatorname{Re}(a_b\\beta_{b,m})}\n"
"     {\\operatorname{Re}(a_t\\beta_{t,0})}\n"
"\\left|\\frac{t_m}{A}\\right|^2."

