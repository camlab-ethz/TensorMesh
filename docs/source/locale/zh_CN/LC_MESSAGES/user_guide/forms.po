#: ../../source/user_guide/forms.rst:4 4e9273641694434587583084e60f1002
msgid "Solving a PDE in TensorMesh starts with two pieces of math:"
msgstr "在 TensorMesh 中求解偏微分方程，首先要写出两个数学表达式："

#: ../../source/user_guide/forms.rst:6 58b026e013194b2ebb5ad0c497309a6d
#, python-brace-format
msgid ""
"a(u, v) \\;=\\; \\int_{\\Omega} \\cdots \\, \\mathrm{d}\\Omega\n"
"\\qquad\n"
"l(v) \\;=\\; \\int_{\\Omega} \\cdots \\, \\mathrm{d}\\Omega"
msgstr ""
"a(u, v) \\;=\\; \\int_{\\Omega} \\cdots \\, \\mathrm{d}\\Omega\n"
