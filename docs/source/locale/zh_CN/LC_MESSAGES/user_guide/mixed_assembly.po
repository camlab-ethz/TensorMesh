msgstr "0维 ``[]``"

#: ../../source/user_guide/mixed_assembly.rst:97
#: 69bddb86fd42448987e395dcd6925c9e
msgid "the field at the quadrature point"
msgstr "求积点处的场值"

#: ../../source/user_guide/mixed_assembly.rst:98
#: 424cdd6d78954ba79b52614f0730f212
msgid "scalar field gradient (``gradp``)"
msgstr "标量场梯度（\\ ``gradp``\\ ）"

#: ../../source/user_guide/mixed_assembly.rst:99
