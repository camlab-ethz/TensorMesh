msgstr "物理空间梯度"

#: ../../source/user_guide/mixed_assembly.rst:101
#: c73de18dc4f54154af9ed2d9d40d51c3
msgid "vector field value (``u``, ``v``)"
msgstr "向量场值（\\ ``u``\\ 、\\ ``v``\\ ）"

